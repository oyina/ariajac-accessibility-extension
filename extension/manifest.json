{
  "manifest_version": 3,
  "name": "AriaJac Accessibility Assistant",
  "version": "0.1.0",
  "description": "A lightweight shell for AriaJac webpage communication.",
  "permissions": ["activeTab"],
  "host_permissions": ["<all_urls>", "https://preview-jac-sbx-49b6bda7e2764429b49a9e64f1df0715.jachammer.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open AriaJac",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/message-contract.js", "shared/dom-snapshot.js", "shared/audit-engine.js", "shared/transformation-engine.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
